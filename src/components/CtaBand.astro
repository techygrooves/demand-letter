---
/** Closing call-to-action band, reused at the bottom of most pages. */
import Icon from './Icon.astro';
import { cta, firm, offer } from '@/config/site';

interface Props {
  title?: string;
  text?: string;
  /** Target for the secondary "Discuss" button. Use '#contact' on pages with a contact section. */
  secondaryHref?: string;
}

const {
  title = 'Start Your Demand Letter Request',
  text = `Tell us about your dispute. The attorney will review whether your matter is suitable for the ${offer.priceDisplay} fixed-fee service before any payment is requested.`,
  secondaryHref = cta.secondary.href,
} = Astro.props;
---

<section class="section section--navy cta-band" aria-labelledby="cta-band-title">
  <div class="container cta-band__inner">
    <div class="cta-band__copy">
      <p class="eyebrow">{offer.priceDisplay} flat fee</p>
      <h2 id="cta-band-title">{title}</h2>
      <p class="lead">{text}</p>
    </div>
    <div class="cta-band__actions">
      <div class="btn-row">
        <a href={cta.request.href} class="btn btn--accent btn--lg">
          {cta.request.label}
          <Icon name="arrow" size={18} />
        </a>
        <a href={secondaryHref} class="btn btn--outline btn--lg">{cta.secondary.label}</a>
      </div>
      <ul class="cta-band__assurances" role="list">
        <li>
          <Icon name="check" size={16} />
          {offer.payment.noUpfront}
        </li>
        <li>
          <Icon name="lock" size={16} />
          {offer.payment.headline}
        </li>
      </ul>
      <p class="cta-band__phone">
        Prefer to talk first? Call <a href={firm.phone.href}>{firm.phone.display}</a>
      </p>
    </div>
  </div>
</section>

<style>
  .cta-band {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(50rem 30rem at 85% 120%, rgb(184 149 90 / 0.2), transparent 60%),
      var(--color-navy-900);
  }

  /* Oversized section-sign watermark for a little visual depth. */
  .cta-band::before {
    content: '§';
    position: absolute;
    right: -2rem;
    top: 50%;
    transform: translateY(-50%);
    font-family: var(--font-serif);
    font-size: clamp(16rem, 30vw, 30rem);
    line-height: 1;
    color: rgb(184 149 90 / 0.06);
    pointer-events: none;
  }

  .cta-band__inner {
    position: relative;
    display: grid;
    gap: var(--space-7);
    align-items: end;
  }

  .cta-band__copy > * + * {
    margin-top: var(--space-4);
  }

  h2 {
    max-width: 16ch;
  }

  .cta-band__actions .btn {
    white-space: normal;
  }

  .cta-band__assurances {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin-top: var(--space-5);
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
    color: var(--color-text-inverse);
  }

  .cta-band__assurances li {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }

  .cta-band__assurances :global(svg) {
    color: var(--color-brass-500);
  }

  .cta-band__phone {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-inverse-muted);
  }

  .cta-band__phone a {
    font-weight: 600;
  }

  @media (min-width: 64rem) {
    .cta-band__inner {
      grid-template-columns: 1fr auto;
      gap: var(--space-8);
    }
  }
</style>
