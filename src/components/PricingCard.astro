---
import Icon from './Icon.astro';
import { offer, cta } from '@/config/site';

interface Props {
  headingLevel?: 'h2' | 'h3';
}

const { headingLevel: Heading = 'h3' } = Astro.props;
---

<article class="pricing-card" aria-labelledby="pricing-card-title">
  <header class="pricing-card__header">
    <Heading id="pricing-card-title" class="pricing-card__title">Attorney Demand Letter</Heading>
    <p class="pricing-card__price">
      <span class="pricing-card__amount">{offer.priceDisplay}</span>
      <span class="pricing-card__label">{offer.priceLabel}</span>
    </p>
    <p class="pricing-card__note">{offer.priceNote}</p>
  </header>

  <ul class="pricing-card__list" role="list">
    {
      offer.included.map((item) => (
        <li>
          <Icon name="check" size={20} />
          <span>{item}</span>
        </li>
      ))
    }
  </ul>

  <a href={cta.primary.href} class="btn btn--lg pricing-card__cta">{cta.primary.label}</a>
  <p class="pricing-card__fine">Subject to attorney review and a conflict check.</p>
</article>

<style>
  .pricing-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: clamp(1.75rem, 1.2rem + 2vw, 2.75rem);
    border: 1px solid var(--color-line);
    border-top: 3px solid var(--color-brass-500);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-lg);
  }

  .pricing-card__title {
    font-size: var(--text-xl);
  }

  .pricing-card__price {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  .pricing-card__amount {
    font-family: var(--font-serif);
    font-size: clamp(3.25rem, 2.6rem + 3vw, 4.5rem);
    font-weight: 500;
    line-height: 1;
    color: var(--color-navy-900);
    letter-spacing: -0.02em;
  }

  .pricing-card__label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-brass-700);
  }

  .pricing-card__note {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }

  .pricing-card__list {
    list-style: none;
    padding: var(--space-5) 0 0;
    border-top: 1px solid var(--color-line);
  }

  .pricing-card__list li {
    display: flex;
    gap: var(--space-3);
    font-size: var(--text-sm);
  }

  .pricing-card__list li + li {
    margin-top: var(--space-3);
  }

  .pricing-card__list :global(svg) {
    flex-shrink: 0;
    color: var(--color-brass-600);
    margin-top: 0.1em;
  }

  .pricing-card__cta {
    width: 100%;
  }

  .pricing-card__fine {
    margin-top: calc(var(--space-2) * -1);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-align: center;
  }
</style>
