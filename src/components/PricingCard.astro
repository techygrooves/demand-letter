---
/**
 * Premium pricing card for the $500 service. All copy comes from `offer` in
 * site config so scope and payment language stay consistent site-wide.
 */
import Icon from './Icon.astro';
import { offer, cta } from '@/config/site';

interface Props {
  headingLevel?: 'h2' | 'h3';
  /** Unique id prefix when more than one card appears on a page. */
  id?: string;
}

const { headingLevel: Heading = 'h3', id = 'pricing-card' } = Astro.props;
---

<article class="pricing-card" aria-labelledby={`${id}-title`}>
  <header class="pricing-card__header">
    <p class="pricing-card__eyebrow">Fixed-fee service</p>
    <Heading id={`${id}-title`} class="pricing-card__title">{offer.serviceName}</Heading>
    <p class="pricing-card__price">
      <span class="pricing-card__amount">{offer.priceDisplay}</span>
      <span class="pricing-card__label">{offer.priceLabel}</span>
    </p>
    <p class="pricing-card__note">{offer.priceNote}</p>
  </header>

  <div class="pricing-card__body">
    <p class="pricing-card__list-title">Core service scope</p>
    <ul class="pricing-card__list" role="list">
      {
        offer.scope.map((item) => (
          <li>
            <span class="pricing-card__check">
              <Icon name="check" size={14} />
            </span>
            <span>{item}</span>
          </li>
        ))
      }
    </ul>

    <p class="pricing-card__payment">
      <Icon name="lock" size={18} />
      <span>{offer.payment.headline}</span>
    </p>

    <a href={cta.request.href} class="btn btn--lg pricing-card__cta">{cta.request.label}</a>

    <ul class="pricing-card__fine" role="list">
      <li>{offer.payment.noUpfront}</li>
      <li>{offer.payment.suitability}</li>
      <li>{offer.payment.engagement}</li>
    </ul>
  </div>
</article>

<style>
  .pricing-card {
    position: relative;
    width: 100%;
    max-width: 32rem;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    transition:
      transform 300ms var(--ease),
      box-shadow 300ms var(--ease);
  }

  @media (hover: hover) {
    .pricing-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 32px 70px -28px rgb(15 31 54 / 0.42);
    }
  }

  .pricing-card__header {
    position: relative;
    padding: clamp(1.75rem, 1.3rem + 1.8vw, 2.5rem);
    background:
      radial-gradient(26rem 14rem at 100% 0%, rgb(184 149 90 / 0.22), transparent 70%),
      var(--color-navy-900);
    color: var(--color-text-inverse);
  }

  .pricing-card__header::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: linear-gradient(90deg, var(--color-brass-600), var(--color-brass-500), var(--color-brass-600));
  }

  .pricing-card__eyebrow {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-brass-500);
  }

  .pricing-card__title {
    margin-top: var(--space-2);
    font-size: var(--text-xl);
    color: var(--color-text-inverse);
  }

  .pricing-card__price {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .pricing-card__amount {
    font-family: var(--font-serif);
    font-size: clamp(3.5rem, 2.8rem + 3vw, 4.75rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-text-inverse);
  }

  .pricing-card__label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-brass-500);
  }

  .pricing-card__note {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--color-text-inverse-muted);
  }

  .pricing-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: clamp(1.75rem, 1.3rem + 1.8vw, 2.5rem);
  }

  .pricing-card__list-title {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .pricing-card__list {
    display: grid;
    gap: var(--space-3);
    margin-top: calc(var(--space-2) * -1);
    padding: 0;
    list-style: none;
  }

  .pricing-card__list li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-weight: 500;
    color: var(--color-navy-900);
  }

  .pricing-card__check {
    display: inline-grid;
    flex-shrink: 0;
    place-items: center;
    width: 1.375rem;
    height: 1.375rem;
    margin-top: 0.15em;
    border-radius: 50%;
    background: var(--color-brass-100);
    color: var(--color-brass-700);
  }

  .pricing-card__payment {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-sm);
    background: var(--color-paper);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-navy-900);
  }

  .pricing-card__payment :global(svg) {
    flex-shrink: 0;
    color: var(--color-brass-600);
  }

  .pricing-card__cta {
    width: 100%;
    white-space: normal;
  }

  .pricing-card__fine {
    display: grid;
    gap: var(--space-1);
    padding: 0;
    list-style: none;
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-align: center;
  }
</style>
