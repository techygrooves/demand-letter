---
/**
 * Accessible FAQ accordion built on native <details>/<summary>, which works
 * with keyboards and screen readers without JavaScript. Enhancements (when JS
 * is available): expand/collapse all, and opening the item named in the URL hash.
 */
import Icon from './Icon.astro';
import type { FaqItem } from '@/data/faq';

interface Props {
  items: FaqItem[];
  /** Show "Expand all / Collapse all" (use on the full FAQ page). */
  showControls?: boolean;
  /** Show question numbers. */
  numbered?: boolean;
}

const { items, showControls = false, numbered = false } = Astro.props;
---

<div class="faq" data-faq>
  {
    showControls && (
      <div class="faq__controls">
        <p class="faq__count">{items.length} questions</p>
        <button type="button" class="faq__toggle-all" data-faq-toggle aria-pressed="false">
          Expand all
        </button>
      </div>
    )
  }

  <div class="faq__list">
    {
      items.map((item, index) => (
        <details class="faq__item" id={`faq-${item.id}`}>
          <summary class="faq__question">
            {numbered && (
              <span class="faq__num" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
            )}
            <span class="faq__q">{item.question}</span>
            <span class="faq__marker" aria-hidden="true" />
          </summary>
          <div class="faq__answer">
            <p>{item.answer[0]}</p>
            {item.list && (
              <ul class="faq__bullets">
                {item.list.map((entry) => (
                  <li>{entry}</li>
                ))}
              </ul>
            )}
            {item.answer.slice(1).map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            {item.links && (
              <p class="faq__links">
                {item.links.map((link) => (
                  <a href={link.href}>
                    {link.label}
                    <Icon name="arrow" size={14} />
                  </a>
                ))}
              </p>
            )}
          </div>
        </details>
      ))
    }
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-faq]').forEach((faq) => {
    const items = [...faq.querySelectorAll<HTMLDetailsElement>('details.faq__item')];
    const toggle = faq.querySelector<HTMLButtonElement>('[data-faq-toggle]');

    const syncToggle = () => {
      if (!toggle) return;
      const allOpen = items.every((item) => item.open);
      toggle.textContent = allOpen ? 'Collapse all' : 'Expand all';
      toggle.setAttribute('aria-pressed', String(allOpen));
    };

    toggle?.addEventListener('click', () => {
      const open = !items.every((item) => item.open);
      items.forEach((item) => (item.open = open));
      syncToggle();
    });
    items.forEach((item) => item.addEventListener('toggle', syncToggle));

    // Open (and scroll to) the question named in the URL, e.g. /faq/#faq-cost.
    const openFromHash = () => {
      const id = decodeURIComponent(window.location.hash.slice(1));
      const target = items.find((item) => item.id === id);
      if (!target) return;
      target.open = true;
      target.scrollIntoView({ block: 'start' });
      target.querySelector('summary')?.focus({ preventScroll: true });
    };
    openFromHash();
    window.addEventListener('hashchange', openFromHash);
  });
</script>

<style>
  .faq__controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  :global(html:not(.js)) .faq__controls {
    display: none;
  }

  .faq__count {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .faq__toggle-all {
    padding: 0.45rem 0.9rem;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-navy-700);
    transition: border-color var(--duration) var(--ease);
  }

  .faq__toggle-all:hover {
    border-color: var(--color-navy-900);
  }

  .faq__list {
    display: grid;
    gap: var(--space-3);
  }

  .faq__item {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    scroll-margin-top: calc(var(--header-height) + var(--space-5));
    transition:
      border-color var(--duration) var(--ease),
      box-shadow var(--duration) var(--ease);
  }

  .faq__item:hover {
    border-color: var(--color-line-strong);
  }

  .faq__item[open] {
    border-color: var(--color-brass-500);
    box-shadow: var(--shadow-md);
  }

  .faq__question {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5) clamp(1rem, 0.7rem + 1.2vw, 1.75rem);
    border-radius: var(--radius-md);
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: var(--leading-snug);
    color: var(--color-navy-900);
    cursor: pointer;
    list-style: none;
  }

  .faq__question::-webkit-details-marker {
    display: none;
  }

  .faq__question:hover .faq__q {
    color: var(--color-brass-700);
  }

  .faq__question:focus-visible {
    outline: 3px solid var(--color-focus);
    outline-offset: 2px;
  }

  .faq__num {
    flex-shrink: 0;
    min-width: 1.75rem;
    font-size: var(--text-base);
    color: var(--color-brass-700);
  }

  .faq__q {
    flex: 1;
    transition: color var(--duration) var(--ease);
  }

  /* Plus that rotates into a minus when open. */
  .faq__marker {
    position: relative;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 50%;
    transition:
      background-color var(--duration) var(--ease),
      border-color var(--duration) var(--ease);
  }

  .faq__marker::before,
  .faq__marker::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.75rem;
    height: 1.5px;
    background: currentColor;
    transform: translate(-50%, -50%);
    transition: transform var(--duration) var(--ease);
  }

  .faq__marker::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .faq__item[open] .faq__marker {
    border-color: var(--color-navy-900);
    background: var(--color-navy-900);
    color: var(--color-brass-500);
  }

  .faq__item[open] .faq__marker::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .faq__answer {
    display: grid;
    gap: var(--space-3);
    padding: 0 clamp(1rem, 0.7rem + 1.2vw, 1.75rem) var(--space-5);
    color: var(--color-text-muted);
  }

  .faq__answer > * {
    max-width: 46rem;
  }

  .faq__bullets {
    display: grid;
    gap: var(--space-1);
    padding-left: 1.25rem;
    color: var(--color-text);
  }

  .faq__bullets li::marker {
    color: var(--color-brass-600);
  }

  .faq__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }

  .faq__links a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .faq__links a:hover {
    text-decoration: underline;
  }

  @media (prefers-reduced-motion: no-preference) {
    .faq__item[open] .faq__answer {
      animation: faq-reveal 220ms var(--ease);
    }
  }

  @keyframes faq-reveal {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  /* Numbered layout aligns answer text with the question. */
  .faq:has(.faq__num) .faq__answer {
    padding-left: calc(clamp(1rem, 0.7rem + 1.2vw, 1.75rem) + 1.75rem + var(--space-4));
  }

  @media (max-width: 30rem) {
    .faq:has(.faq__num) .faq__answer {
      padding-left: clamp(1rem, 0.7rem + 1.2vw, 1.75rem);
    }
  }
</style>
