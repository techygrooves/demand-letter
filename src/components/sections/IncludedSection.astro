---
import SectionHeading from '@/components/SectionHeading.astro';
import PricingCard from '@/components/PricingCard.astro';
import Icon from '@/components/Icon.astro';
import { offer } from '@/config/site';
---

<section class="section" id="included" aria-labelledby="included-title">
  <div class="container">
    <SectionHeading
      eyebrow={`The ${offer.priceDisplay} Service`}
      title="What’s included in your flat fee"
      id="included-title"
    >
      One transparent price for a complete, attorney-prepared demand letter. You know the full cost before you begin.
    </SectionHeading>

    <div class="included reveal">
      <ul class="included__grid" role="list">
        {
          offer.includedDetail.map((item) => (
            <li class="included__item">
              <span class="included__icon">
                <Icon name={item.icon} size={22} />
              </span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <div class="included__aside">
        <PricingCard />
      </div>
    </div>

    <p class="included__excluded">
      <strong>Please note:</strong>
      {offer.excluded}
    </p>
  </div>
</section>

<style>
  .included {
    display: grid;
    gap: var(--space-7);
    align-items: start;
  }

  @media (min-width: 64rem) {
    .included {
      grid-template-columns: minmax(0, 1fr) minmax(20rem, 26rem);
      gap: var(--space-8);
    }

    .included__aside {
      position: sticky;
      top: calc(var(--header-height) + var(--space-5));
    }
  }

  .included__grid {
    display: grid;
    gap: var(--space-6) var(--space-6);
    padding: 0;
  }

  @media (min-width: 40rem) {
    .included__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .included__item {
    display: flex;
    gap: var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-line);
  }

  .included__icon {
    display: inline-grid;
    flex-shrink: 0;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-sm);
    background: var(--color-navy-900);
    color: var(--color-brass-500);
  }

  .included__item h3 {
    font-size: var(--text-lg);
  }

  .included__item p {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .included__excluded {
    max-width: 52rem;
    margin-top: var(--space-7);
    padding-left: var(--space-5);
    border-left: 2px solid var(--color-brass-500);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .included__excluded strong {
    color: var(--color-navy-900);
  }
</style>
