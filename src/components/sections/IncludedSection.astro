---
import SectionHeading from '@/components/SectionHeading.astro';
import PricingCard from '@/components/PricingCard.astro';
import Icon from '@/components/Icon.astro';
import { offer } from '@/config/site';
import { url } from '@/lib/url';
---

<section class="section" id="included" aria-labelledby="included-title">
  <div class="container">
    <SectionHeading eyebrow="Transparent Pricing" title={`What’s included for ${offer.priceDisplay}`} id="included-title">
      One fixed fee for a clearly defined service. Your matter is reviewed for suitability before any payment is
      requested.
    </SectionHeading>

    <div class="included reveal">
      <div class="included__main">
        <ul class="included__grid" role="list">
          {
            offer.scopeDetail.map((item) => (
              <li class="included__item">
                <span class="included__icon">
                  <Icon name={item.icon} size={22} />
                </span>
                <div>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                </div>
              </li>
            ))
          }
        </ul>
        <div class="separate">
          <div class="separate__copy">
            <h3 class="separate__title">May require a separate engagement</h3>
            <ul class="separate__list" role="list">
              {offer.additionalWork.map((item) => <li>{item.title}</li>)}
            </ul>
          </div>
          <a href={url('/pricing/#scope')} class="separate__link">
            See full scope and pricing <Icon name="arrow" size={16} />
          </a>
        </div>
      </div>

      <div class="included__aside">
        <PricingCard />
      </div>
    </div>
  </div>
</section>

<style>
  .included {
    display: grid;
    gap: var(--space-7);
    align-items: start;
  }

  /* Keep the pricing card at a readable width on tablets. */
  .included__aside {
    width: 100%;
    max-width: 30rem;
    margin-inline: auto;
  }

  @media (min-width: 64rem) {
    .included__aside {
      max-width: none;
    }

    .included {
      grid-template-columns: minmax(0, 1fr) minmax(20rem, 26rem);
      gap: var(--space-8);
    }
  }

  .included__grid {
    display: grid;
    gap: var(--space-6);
    padding: 0;
  }

  @media (min-width: 40rem) {
    .included__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .included__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-line);
  }

  .included__icon {
    display: inline-grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: var(--radius-sm);
    background: var(--color-navy-900);
    color: var(--color-brass-500);
    transition: transform var(--duration) var(--ease);
  }

  .included__item:hover .included__icon {
    transform: translateY(-2px) rotate(-3deg);
  }

  .included__item h3 {
    font-size: var(--text-lg);
  }

  .included__item p {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .separate {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4) var(--space-6);
    margin-top: var(--space-7);
    padding: var(--space-5) var(--space-6);
    background: var(--color-stone);
    border: 1px dashed var(--color-line-strong);
    border-radius: var(--radius-md);
  }

  .separate__title {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .separate__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-3);
    padding: 0;
    list-style: none;
  }

  .separate__list li {
    padding: 0.3rem 0.8rem;
    border: 1px solid var(--color-line-strong);
    border-radius: 99px;
    font-size: var(--text-sm);
    color: var(--color-navy-900);
  }

  .separate__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 600;
    text-decoration: none;
  }

  .separate__link :global(svg) {
    transition: transform var(--duration) var(--ease);
  }

  .separate__link:hover :global(svg) {
    transform: translateX(3px);
  }
</style>
