---
import Icon from '@/components/Icon.astro';
import { cta, firm, offer } from '@/config/site';

// The first highlight ($500 flat fee) is rendered as the large price figure.
const highlights = offer.highlights.slice(1);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">Florida Attorney Demand Letters</p>
      <h1 id="hero-title">
        Get an Attorney-Prepared Demand Letter for <span class="hero__price">{offer.priceDisplay}</span>
      </h1>
      <p class="lead">
        Whether you’re dealing with unpaid money, a broken agreement, property damage, or another civil dispute,
        {firm.name} can help you take a professional first step toward resolution.
      </p>
      <div class="btn-row hero__actions">
        <a href={cta.primary.href} class="btn btn--lg">
          {cta.primary.label}
          <Icon name="arrow" size={18} class="btn__arrow" />
        </a>
        <a href="#contact" class="btn btn--outline btn--lg">{cta.secondary.label}</a>
      </div>
      <p class="hero__call">
        {offer.payment.noUpfront} Prefer to talk first? Call <a href={firm.phone.href}>{firm.phone.display}</a>
      </p>
    </div>

    <aside class="offer" aria-labelledby="offer-title">
      <div class="offer__letterhead" aria-hidden="true">
        <span class="offer__firm">{firm.name}</span>
        <span class="offer__address">{firm.address.city}, Florida</span>
      </div>

      <div class="offer__body">
        <h2 id="offer-title" class="visually-hidden">What you get</h2>
        <p class="offer__price">
          <span class="offer__amount">{offer.priceDisplay}</span>
          <span class="offer__label">{offer.priceLabel} · No hourly billing</span>
        </p>
        <ul class="offer__list" role="list">
          {
            highlights.map((item) => (
              <li>
                <span class="offer__check">
                  <Icon name="check" size={16} />
                </span>
                {item}
              </li>
            ))
          }
        </ul>
        <p class="offer__note">{offer.payment.suitability}</p>
      </div>

      <div class="offer__sign" aria-hidden="true">
        <span class="offer__signature">{firm.attorney}</span>
        <span class="offer__title">Attorney at Law</span>
      </div>
    </aside>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3rem, 1.8rem + 5.5vw, 7rem) clamp(3.5rem, 2rem + 6vw, 7.5rem);
    overflow: hidden;
    background:
      radial-gradient(60rem 36rem at 105% -5%, rgb(184 149 90 / 0.14), transparent 60%),
      radial-gradient(40rem 30rem at -10% 110%, rgb(31 58 97 / 0.06), transparent 60%),
      linear-gradient(180deg, var(--color-paper), var(--color-stone));
  }

  /* Faint ruled lines evoke legal paper without competing with content. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(
      180deg,
      transparent 0,
      transparent 39px,
      rgb(15 31 54 / 0.035) 39px,
      rgb(15 31 54 / 0.035) 40px
    );
    mask-image: linear-gradient(90deg, transparent, #000 30%, #000 70%, transparent);
    pointer-events: none;
  }

  .hero__grid {
    position: relative;
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      gap: clamp(3rem, 6vw, 7rem);
    }
  }

  .hero__copy > * + * {
    margin-top: var(--space-5);
  }

  h1 {
    max-width: 16ch;
    font-size: clamp(2.5rem, 1.7rem + 3.4vw, 4.5rem);
  }

  .hero__price {
    font-style: italic;
    color: var(--color-brass-700);
    white-space: nowrap;
  }

  .hero__copy .lead {
    max-width: 34rem;
  }

  .hero__actions {
    margin-top: var(--space-6);
  }

  .hero__actions :global(.btn__arrow) {
    transition: transform var(--duration) var(--ease);
  }

  .hero__actions .btn:hover :global(.btn__arrow) {
    transform: translateX(3px);
  }

  .hero__call {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .hero__call a {
    font-weight: 600;
    white-space: nowrap;
  }

  /* ---------- Offer card, styled as firm letterhead ---------- */
  .offer {
    position: relative;
    width: 100%;
    max-width: 28rem;
    margin-inline: auto;
    border-radius: var(--radius-md);
    background: var(--color-surface);
    box-shadow: var(--shadow-lg);
    transition:
      transform 300ms var(--ease),
      box-shadow 300ms var(--ease);
  }

  .offer::before {
    content: '';
    position: absolute;
    inset: 1rem -1rem -1rem 1rem;
    z-index: -1;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-md);
  }

  @media (hover: hover) {
    .offer:hover {
      transform: translateY(-4px);
      box-shadow: 0 32px 70px -28px rgb(15 31 54 / 0.42);
    }
  }

  .offer__letterhead {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-5) var(--space-5) var(--space-4);
    border-bottom: 1px solid var(--color-line);
    border-top: 4px solid var(--color-navy-900);
    border-radius: var(--radius-md) var(--radius-md) 0 0;
  }

  .offer__firm {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-navy-900);
  }

  .offer__address {
    font-size: 0.6875rem;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .offer__body {
    padding: clamp(1.5rem, 1.1rem + 1.6vw, 2.25rem);
  }

  .offer__price {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-5);
    border: 1px solid var(--color-brass-100);
    border-radius: var(--radius-sm);
    background: #fdfaf3;
    text-align: center;
  }

  .offer__amount {
    font-family: var(--font-serif);
    font-size: clamp(3.5rem, 2.8rem + 3vw, 4.75rem);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-navy-900);
  }

  .offer__label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-brass-700);
  }

  .offer__list {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-5);
    padding: 0;
    list-style: none;
    font-weight: 500;
    color: var(--color-navy-900);
  }

  .offer__list li {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .offer__check {
    display: inline-grid;
    flex-shrink: 0;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 50%;
    background: var(--color-navy-900);
    color: var(--color-brass-500);
  }

  .offer__note {
    margin-top: var(--space-5);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
    text-align: center;
  }

  .offer__sign {
    display: flex;
    flex-direction: column;
    padding: var(--space-4) clamp(1.5rem, 1.1rem + 1.6vw, 2.25rem) var(--space-5);
    border-top: 1px dashed var(--color-line);
  }

  .offer__signature {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-style: italic;
    color: var(--color-navy-800);
  }

  .offer__title {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }
</style>
