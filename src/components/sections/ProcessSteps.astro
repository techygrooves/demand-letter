---
import SectionHeading from '@/components/SectionHeading.astro';
import Icon from '@/components/Icon.astro';
import { steps, cta, offer } from '@/config/site';

interface Props {
  /** Show the section heading (hide when the page hero already introduces the topic). */
  showHeading?: boolean;
  tone?: 'default' | 'stone' | 'navy';
  /** Show the per-step detail bullets. */
  detailed?: boolean;
  showCta?: boolean;
}

const { showHeading = true, tone = 'stone', detailed = false, showCta = true } = Astro.props;

/** Index of the engagement/payment step, highlighted so clients see when payment happens. */
const paymentStep = 2;
---

<section
  class:list={['section', 'process', `section--${tone}`, { 'process--detailed': detailed }]}
  id="process"
  aria-labelledby="process-title"
>
  <div class="container">
    {
      showHeading ? (
        <SectionHeading eyebrow="How It Works" title="A clear, four-step process" id="process-title">
          Every request is reviewed by the attorney before any payment is requested, so you know where you stand from
          the start.
        </SectionHeading>
      ) : (
        <h2 id="process-title" class="visually-hidden">
          The four steps
        </h2>
      )
    }

    <ol class="steps reveal" role="list">
      {
        steps.map((step, index) => (
          <li class:list={['step', { 'step--payment': index === paymentStep }]}>
            <div class="step__top">
              <span class="step__icon">
                <Icon name={step.icon} size={24} />
              </span>
              <span class="step__number" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
            </div>
            <p class="step__label">Step {index + 1}</p>
            <h3>{step.title}</h3>
            <p class="step__text">{step.text}</p>
            {detailed && (
              <ul class="step__details" role="list">
                {step.details.map((detail) => (
                  <li>
                    <Icon name="check" size={16} />
                    {detail}
                  </li>
                ))}
              </ul>
            )}
            {index === paymentStep && (
              <p class="step__badge">
                <Icon name="lock" size={14} />
                Only after acceptance
              </p>
            )}
          </li>
        ))
      }
    </ol>

    {
      showCta && (
        <div class="process__cta">
          <a href={cta.request.href} class="btn btn--accent btn--lg">
            {cta.request.label}
            <Icon name="arrow" size={18} />
          </a>
          <p>
            {offer.payment.noUpfront} {offer.payment.suitability}
          </p>
        </div>
      )
    }
  </div>
</section>

<style>
  .section--default {
    background: transparent;
  }

  .steps {
    display: grid;
    gap: var(--space-5);
    padding: 0;
    counter-reset: step;
  }

  @media (min-width: 40rem) {
    .steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 72rem) {
    .steps {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: clamp(1.5rem, 1.2rem + 1vw, 2rem);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    transition:
      transform var(--duration) var(--ease),
      box-shadow var(--duration) var(--ease),
      border-color var(--duration) var(--ease);
  }

  /* Chevron connector between cards on wide screens. */
  @media (min-width: 72rem) {
    .step:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 2.6rem;
      right: calc(var(--space-5) * -0.5 - 0.35rem);
      z-index: 1;
      width: 0.7rem;
      height: 0.7rem;
      border-top: 1.5px solid var(--color-brass-500);
      border-right: 1.5px solid var(--color-brass-500);
      transform: rotate(45deg);
    }
  }

  @media (hover: hover) {
    .step:hover {
      transform: translateY(-4px);
      border-color: var(--color-brass-500);
      box-shadow: var(--shadow-md);
    }

    .step:hover .step__icon {
      background: var(--color-brass-500);
      color: var(--color-navy-950);
    }
  }

  .step__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: var(--space-2);
  }

  .step__icon {
    display: inline-grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: var(--radius-sm);
    background: var(--color-navy-900);
    color: var(--color-brass-500);
    transition:
      background-color var(--duration) var(--ease),
      color var(--duration) var(--ease);
  }

  .step__number {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    line-height: 0.8;
    color: var(--color-line-strong);
  }

  .step__label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-brass-700);
  }

  .step h3 {
    font-size: var(--text-lg);
  }

  .step__text {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .step__details {
    display: grid;
    gap: var(--space-2);
    margin-top: var(--space-2);
    padding: var(--space-4) 0 0;
    border-top: 1px solid var(--color-line);
    list-style: none;
    font-size: var(--text-sm);
    color: var(--color-navy-900);
  }

  .step__details li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .step__details :global(svg) {
    flex-shrink: 0;
    margin-top: 0.2em;
    color: var(--color-brass-600);
  }

  .step__badge {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: var(--space-2);
    margin-top: auto;
    padding: 0.3rem 0.7rem;
    border-radius: 99px;
    background: var(--color-brass-100);
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-brass-700);
  }

  .step--payment {
    border-color: var(--color-brass-500);
  }

  /* Navy section variant: glassy cards on dark background. */
  .section--navy .step {
    border-color: rgb(255 255 255 / 0.12);
    background: rgb(255 255 255 / 0.04);
  }

  .section--navy .step--payment {
    border-color: rgb(184 149 90 / 0.6);
  }

  .section--navy .step:hover {
    border-color: var(--color-brass-500);
    background: rgb(255 255 255 / 0.07);
  }

  .section--navy .step__icon {
    background: rgb(184 149 90 / 0.14);
  }

  .section--navy .step__number {
    color: rgb(255 255 255 / 0.14);
  }

  .section--navy .step__label {
    color: var(--color-brass-500);
  }

  .section--navy .step__text {
    color: var(--color-text-inverse-muted);
  }

  .section--navy .step__details {
    border-top-color: rgb(255 255 255 / 0.12);
    color: var(--color-text-inverse);
  }

  .section--navy .step__badge {
    background: rgb(184 149 90 / 0.16);
    color: var(--color-brass-500);
  }

  .process__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-6);
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid rgb(127 127 127 / 0.2);
  }

  .process__cta .btn {
    white-space: normal;
  }

  .process__cta p {
    flex: 1 1 18rem;
    font-size: var(--text-sm);
    opacity: 0.85;
  }
</style>
