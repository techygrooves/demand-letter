---
import SectionHeading from '@/components/SectionHeading.astro';
import Icon from '@/components/Icon.astro';

const purposes = [
  {
    title: 'Communicates your position',
    text: 'The letter lays out the relevant facts, what went wrong and why you believe you are owed a remedy, in clear and professional terms.',
  },
  {
    title: 'Requests a specific resolution',
    text: 'It states exactly what you want, whether payment, repair, a refund or performance under an agreement, and sets a deadline to respond.',
  },
  {
    title: 'Creates an opportunity to resolve it',
    text: 'A formal demand gives the other party a chance to resolve the dispute and may help you avoid immediately filing a lawsuit.',
  },
];

const comparison = [
  {
    diy: 'Written from your perspective, often with emotion',
    attorney: 'Measured, professional tone focused on the facts',
  },
  {
    diy: 'Easy for the recipient to set aside',
    attorney: 'Issued on law firm letterhead and signed by an attorney',
  },
  {
    diy: 'Vague requests and open-ended timelines',
    attorney: 'A specific demand with a clear deadline',
  },
  {
    diy: 'May overstate or omit important points',
    attorney: 'Prepared with an attorney’s review of your facts and documents',
  },
];
---

<section class="section" id="why" aria-labelledby="why-title">
  <div class="container">
    <div class="why__intro">
      <SectionHeading eyebrow="Why It Matters" title="A demand letter puts your dispute on the record" id="why-title" />
      <div class="why__lead stack">
        <p class="lead">
          A demand letter is a formal written notice to the person or business you are in a dispute with. When it comes
          from an attorney, it shows that you are serious about your claim and prepared to protect your rights.
        </p>
        <p class="muted">
          Many disputes are resolved once the other side understands your position and the potential consequences of
          ignoring it. A demand letter is often a practical, cost-effective first step before considering litigation.
        </p>
      </div>
    </div>

    <ol class="purposes reveal" role="list">
      {
        purposes.map((item, index) => (
          <li class="purpose">
            <span class="purpose__num" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))
      }
    </ol>

    <div class="compare reveal" role="table" aria-label="Writing your own letter compared with an attorney-prepared demand letter">
      <div class="compare__row compare__row--head" role="row">
        <span role="columnheader">Writing it yourself</span>
        <span role="columnheader">Attorney-prepared demand letter</span>
      </div>
      {
        comparison.map((row) => (
          <div class="compare__row" role="row">
            <span role="cell" class="compare__diy">
              {row.diy}
            </span>
            <span role="cell" class="compare__attorney">
              <Icon name="check" size={18} />
              {row.attorney}
            </span>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .why__intro {
    display: grid;
    gap: var(--space-5);
    margin-bottom: var(--space-8);
  }

  .why__intro :global(.section-heading) {
    margin-bottom: 0;
  }

  @media (min-width: 64rem) {
    .why__intro {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-9);
      align-items: end;
    }
  }

  .purposes {
    display: grid;
    gap: var(--space-5);
    padding: 0;
  }

  @media (min-width: 48rem) {
    .purposes {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .purpose {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: clamp(1.5rem, 1.2rem + 1.2vw, 2.25rem);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    transition:
      transform var(--duration) var(--ease),
      box-shadow var(--duration) var(--ease),
      border-color var(--duration) var(--ease);
  }

  @media (hover: hover) {
    .purpose:hover {
      transform: translateY(-3px);
      border-color: var(--color-line-strong);
      box-shadow: var(--shadow-md);
    }
  }

  .purpose__num {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    line-height: 1;
    color: var(--color-brass-600);
  }

  .purpose p {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* Comparison */
  .compare {
    margin-top: var(--space-8);
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--color-line);
    font-size: var(--text-sm);
  }

  .compare__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
  }

  .compare__row > span {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding: var(--space-4) clamp(1rem, 0.6rem + 1.5vw, 2rem);
  }

  .compare__row + .compare__row {
    border-top: 1px solid var(--color-line);
  }

  .compare__row--head > span {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .compare__row--head > span:first-child {
    background: var(--color-stone);
    color: var(--color-text-muted);
  }

  .compare__row--head > span:last-child {
    background: var(--color-navy-900);
    color: var(--color-brass-500);
  }

  .compare__diy {
    background: var(--color-stone);
    color: var(--color-text-muted);
  }

  .compare__attorney {
    background: var(--color-surface);
    font-weight: 500;
    color: var(--color-navy-900);
  }

  @media (max-width: 39.999rem) {
    .compare__row {
      grid-template-columns: 1fr;
    }

    .compare__row--head {
      display: none;
    }

    .compare__diy {
      padding-bottom: var(--space-2) !important;
    }

    .compare__diy::before {
      content: 'Yourself:';
      flex-shrink: 0;
      font-size: var(--text-xs);
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      padding-top: 0.15em;
    }
  }

  .compare__attorney :global(svg) {
    flex-shrink: 0;
    margin-top: 0.15em;
    color: var(--color-brass-600);
  }
</style>
