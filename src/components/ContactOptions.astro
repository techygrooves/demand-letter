---
/** Phone / email / office contact cards. Used on Contact and Get Started pages. */
import Icon from './Icon.astro';
import { firm } from '@/config/site';

const address = `${firm.address.street}, ${firm.address.city}, ${firm.address.region} ${firm.address.postalCode}`;

const items = [
  { icon: 'phone', label: 'Call', value: firm.phone.display, href: firm.phone.href },
  { icon: 'mail', label: 'Email', value: firm.email, href: `mailto:${firm.email}` },
  {
    icon: 'pin',
    label: 'Office',
    value: address,
    href: `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`,
    external: true,
  },
] as const;
---

<ul class="contact-options" role="list">
  {
    items.map((item) => (
      <li class="contact-option">
        <span class="contact-option__icon">
          <Icon name={item.icon} />
        </span>
        <span class="contact-option__label">{item.label}</span>
        <a
          class="contact-option__value"
          href={item.href}
          {...('external' in item ? { target: '_blank', rel: 'noopener' } : {})}
        >
          {item.value}
          {'external' in item && <span class="visually-hidden"> (opens Google Maps in a new tab)</span>}
        </a>
      </li>
    ))
  }
</ul>

<style>
  .contact-options {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: var(--space-5);
    padding: 0;
    list-style: none;
  }

  .contact-option {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-6);
    position: relative;
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    transition:
      transform var(--duration) var(--ease),
      box-shadow var(--duration) var(--ease),
      border-color var(--duration) var(--ease);
  }

  /* Whole card is clickable via the link's stretched pseudo-element. */
  .contact-option__value::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  @media (hover: hover) {
    .contact-option:hover {
      transform: translateY(-3px);
      border-color: var(--color-brass-500);
      box-shadow: var(--shadow-md);
    }
  }

  .contact-option:focus-within {
    border-color: var(--color-brass-500);
  }

  .contact-option__icon {
    margin-bottom: var(--space-2);
    color: var(--color-brass-600);
  }

  .contact-option__label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .contact-option__value {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--color-navy-900);
    overflow-wrap: anywhere;
  }

  .contact-option__value {
    text-decoration: none;
  }

  .contact-option:hover .contact-option__value {
    color: var(--color-brass-700);
  }
</style>
