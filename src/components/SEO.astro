---
/**
 * Page-level meta tags, Open Graph / Twitter cards and LegalService structured data.
 */
import { firm, site, offer } from '@/config/site';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
}

const { title, description = site.description, image = site.ogImage, noindex = false } = Astro.props;

const fullTitle = title ? `${title} | ${firm.name}` : site.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'LegalService',
  name: `${firm.name} Demand Letters`,
  legalName: firm.legalName,
  url: Astro.site?.toString(),
  sameAs: [firm.website],
  telephone: firm.phone.e164,
  email: firm.email,
  description: site.description,
  areaServed: { '@type': 'State', name: firm.areaServed },
  address: {
    '@type': 'PostalAddress',
    streetAddress: firm.address.street,
    addressLocality: firm.address.city,
    addressRegion: firm.address.region,
    postalCode: firm.address.postalCode,
    addressCountry: firm.address.country,
  },
  employee: { '@type': 'Person', name: firm.attorney, jobTitle: 'Attorney' },
  makesOffer: {
    '@type': 'Offer',
    name: 'Attorney-prepared demand letter',
    price: offer.price,
    priceCurrency: 'USD',
  },
};
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content="website" />
<meta property="og:locale" content={site.locale} />
<meta property="og:site_name" content={firm.name} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />

<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
