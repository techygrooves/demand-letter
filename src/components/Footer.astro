---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { firm, primaryNav, legalNav, cta, disclaimers, offer, firmPolicyLinks } from '@/config/site';
import { url } from '@/lib/url';

const year = new Date().getFullYear();
const legalLinks = [
  ...legalNav,
  ...(firmPolicyLinks.privacy ? [{ label: 'Firm Privacy Policy', href: firmPolicyLinks.privacy }] : []),
  ...(firmPolicyLinks.terms ? [{ label: 'Firm Terms', href: firmPolicyLinks.terms }] : []),
];
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `${firm.address.street}, ${firm.address.city}, ${firm.address.region} ${firm.address.postalCode}`,
)}`;
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <Logo inverse />
        <p class="site-footer__summary">
          Attorney-prepared demand letters for Florida civil disputes, for a {offer.priceDisplay} flat fee. Payment
          only after your matter is accepted.
        </p>
        <a href={cta.request.href} class="btn btn--accent">{cta.request.label}</a>
      </div>

      <nav class="site-footer__col" aria-label="Footer">
        <h2 class="site-footer__heading">Explore</h2>
        <ul role="list">
          <li><a href={url('/')}>Home</a></li>
          {
            primaryNav.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="site-footer__col">
        <h2 class="site-footer__heading">Contact</h2>
        <address>
          <ul role="list" class="site-footer__contact">
            <li>
              <Icon name="phone" size={18} />
              <a href={firm.phone.href}>{firm.phone.display}</a>
            </li>
            <li>
              <Icon name="mail" size={18} />
              <a href={`mailto:${firm.email}`}>{firm.email}</a>
            </li>
            <li>
              <Icon name="pin" size={18} />
              <a href={mapsUrl} rel="noopener" target="_blank">
                {firm.address.street}<br />
                {firm.address.city}, {firm.address.region} {firm.address.postalCode}
                <span class="visually-hidden">(opens Google Maps in a new tab)</span>
              </a>
            </li>
          </ul>
        </address>
      </div>
    </div>

    <div class="site-footer__legal">
      <p><strong>Attorney advertising.</strong> {disclaimers.attorneyAdvertising} {disclaimers.advertising}</p>
      <p>{disclaimers.noRelationship} {disclaimers.results}</p>
      <p>{disclaimers.jurisdiction}</p>
    </div>

    <div class="site-footer__bottom">
      <p>
        &copy; {year}
        {firm.legalName}. All rights reserved. Visit the firm at
        <a href={firm.website} rel="noopener">hoffman.legal</a>.
      </p>
      <ul role="list" class="site-footer__legal-nav">
        {
          legalLinks.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    padding-block: var(--space-8) var(--space-6);
    background: var(--color-navy-950);
    color: var(--color-text-inverse-muted);
    font-size: var(--text-sm);
  }

  .site-footer a:not(.btn) {
    color: var(--color-text-inverse);
    text-decoration: none;
  }

  /* Links inside sentences stay underlined so they are not identified by color alone. */
  .site-footer p a:not(.btn) {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .site-footer a:not(.btn):hover {
    color: var(--color-brass-500);
    text-decoration: underline;
  }

  .site-footer ul {
    list-style: none;
    padding: 0;
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-7);
  }

  @media (min-width: 48rem) {
    .site-footer__grid {
      grid-template-columns: 1.6fr 1fr 1.3fr;
      gap: var(--space-6);
    }
  }

  .site-footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
  }

  .site-footer__summary {
    max-width: 22rem;
  }

  .site-footer__heading {
    margin-bottom: var(--space-4);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-brass-500);
  }

  .site-footer__col li + li {
    margin-top: var(--space-3);
  }

  address {
    font-style: normal;
  }

  .site-footer__contact li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .site-footer__contact :global(svg) {
    flex-shrink: 0;
    margin-top: 0.2em;
    color: var(--color-brass-500);
  }

  .site-footer__legal {
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid rgb(255 255 255 / 0.12);
    font-size: var(--text-xs);
    line-height: 1.7;
  }

  .site-footer__legal p {
    max-width: 62rem;
  }

  .site-footer__legal p + p {
    margin-top: var(--space-3);
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-6);
    font-size: var(--text-xs);
  }

  .site-footer__legal-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
  }
</style>
