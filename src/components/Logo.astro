---
import { firm } from '@/config/site';
import { url } from '@/lib/url';

interface Props {
  /** Use on dark backgrounds. */
  inverse?: boolean;
}

const { inverse = false } = Astro.props;
---

<a href={url('/')} class:list={['logo', { 'logo--inverse': inverse }]} aria-label={`${firm.name}, demand letters home`}>
  <span class="logo__mark" aria-hidden="true">H</span>
  <span class="logo__text">
    <span class="logo__name">{firm.name}</span>
    <span class="logo__tag">Demand Letters</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-navy-900);
    text-decoration: none;
  }

  .logo:hover {
    color: var(--color-navy-900);
  }

  .logo__mark {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--color-brass-600);
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1;
    color: var(--color-brass-700);
  }

  .logo__text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }

  .logo__name {
    white-space: nowrap;
    font-family: var(--font-serif);
    font-size: 1.375rem;
    font-weight: 500;
    letter-spacing: 0.01em;
  }

  .logo__tag {
    margin-top: 0.2rem;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .logo--inverse,
  .logo--inverse:hover {
    color: var(--color-text-inverse);
  }

  .logo--inverse .logo__mark {
    border-color: var(--color-brass-500);
    color: var(--color-brass-500);
  }

  .logo--inverse .logo__tag {
    color: var(--color-text-inverse-muted);
  }
</style>
