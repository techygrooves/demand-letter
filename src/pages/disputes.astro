---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import DisputeTypes from '@/components/sections/DisputeTypes.astro';
import ProcessSteps from '@/components/sections/ProcessSteps.astro';
import { offer } from '@/config/site';
---

<BaseLayout
  title="Demand Letters for Money Owed, Contracts & More"
  description={`Florida demand letters for money owed, breach of contract, landlord-tenant, business and other civil disputes. All matters are subject to attorney assessment.`}
>
  <PageHero eyebrow="Types of Disputes" title="Types of Disputes We Handle">
    From a demand letter for money owed to breach of contract, landlord-tenant and business disputes, an attorney’s
    letter can be a practical first step. The fee is {offer.priceDisplay} for one suitable demand letter, subject to
    attorney review and acceptance.
  </PageHero>

  <DisputeTypes showHeading={false} tone="default" />

  <ProcessSteps tone="navy" />
</BaseLayout>
