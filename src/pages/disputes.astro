---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import DisputeTypes from '@/components/sections/DisputeTypes.astro';
import ProcessSteps from '@/components/sections/ProcessSteps.astro';
import { offer } from '@/config/site';
---

<BaseLayout
  title="Types of Disputes We Handle"
  description={`Examples of civil disputes where Hoffman Legal may prepare a ${offer.priceDisplay} attorney demand letter: unpaid debts, breach of contract, landlord-tenant, property, consumer, business, contractor, employment-related and insurance disputes. All matters are subject to attorney assessment.`}
>
  <PageHero eyebrow="Types of Disputes" title="Types of Disputes We Handle">
    A demand letter can be an effective first step in many civil disputes. The fee is {offer.priceDisplay} for one
    suitable demand letter, subject to attorney review and acceptance.
  </PageHero>

  <DisputeTypes showHeading={false} tone="default" />

  <ProcessSteps tone="navy" />
</BaseLayout>
