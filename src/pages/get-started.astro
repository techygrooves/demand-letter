---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import ContactOptions from '@/components/ContactOptions.astro';
import Icon from '@/components/Icon.astro';
import { offer, steps } from '@/config/site';
---

<BaseLayout
  title="Start Your Demand Letter Request"
  description={`Start your request for an attorney-prepared demand letter from Hoffman Legal. ${offer.payment.noUpfront} ${offer.payment.suitability}`}
>
  <PageHero eyebrow={`${offer.priceDisplay} Fixed Fee`} title="Start Your Demand Letter Request">
    Tell us about your dispute. {offer.payment.noUpfront} {offer.payment.suitability}
  </PageHero>

  <section class="section" aria-labelledby="request-title">
    <div class="container request">
      <div>
        <!-- TODO: Replace with the online intake form (Step 1) in a later step. -->
        <h2 id="request-title" class="request__title">Submit your request</h2>
        <p class="request__intro">
          Contact the firm with a brief description of the dispute, the opposing party and the resolution you want.
        </p>
        <ContactOptions />
        <p class="request__note">
          Please do not send confidential information until an attorney-client relationship has been established.
        </p>
      </div>

      <aside class="request__next" aria-labelledby="next-title">
        <h2 id="next-title" class="request__next-title">What happens next</h2>
        <ol role="list">
          {
            steps.map((step, index) => (
              <li>
                <span class="request__num" aria-hidden="true">
                  {index + 1}
                </span>
                <div>
                  <strong>{step.title}</strong>
                  <p>{step.text}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <p class="request__payment">
          <Icon name="lock" size={18} />
          {offer.payment.headline}
        </p>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .request {
    display: grid;
    gap: var(--space-8);
    align-items: start;
  }

  @media (min-width: 64rem) {
    .request {
      grid-template-columns: 1.4fr 1fr;
    }
  }

  .request__title {
    font-size: var(--text-2xl);
  }

  .request__intro {
    margin: var(--space-3) 0 var(--space-6);
    color: var(--color-text-muted);
  }

  .request__note {
    margin-top: var(--space-5);
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  .request__next {
    padding: clamp(1.5rem, 1.2rem + 1.5vw, 2.5rem);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background: var(--color-stone);
  }

  .request__next-title {
    font-size: var(--text-xl);
  }

  .request__next ol {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-5);
    padding: 0;
  }

  .request__next li {
    display: flex;
    gap: var(--space-4);
  }

  .request__num {
    display: inline-grid;
    flex-shrink: 0;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--color-brass-500);
    border-radius: 50%;
    font-family: var(--font-serif);
    color: var(--color-brass-700);
  }

  .request__next strong {
    color: var(--color-navy-900);
  }

  .request__next p {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .request__payment {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-line-strong);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-navy-900);
  }

  .request__payment :global(svg) {
    color: var(--color-brass-600);
  }
</style>
