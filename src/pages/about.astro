---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import AttorneyProfile from '@/components/sections/AttorneyProfile.astro';
import LegalNotice from '@/components/LegalNotice.astro';
import CtaBand from '@/components/CtaBand.astro';
import { firm } from '@/config/site';
---

<BaseLayout
  title="About the Attorney"
  description={`The ${firm.name} demand letter service is provided through ${firm.legalName}, a Florida law firm in ${firm.address.city}. Requests are reviewed by attorney ${firm.attorney}.`}
>
  <PageHero eyebrow="About" title={`${firm.name} and attorney ${firm.attorney}`}>
    The demand letter service on this website is provided through {firm.name}, a Florida law firm in
    {firm.address.city}.
  </PageHero>

  <AttorneyProfile />

  <section class="section section--stone" aria-label="Important information">
    <div class="container">
      <LegalNotice />
    </div>
  </section>

  <CtaBand />
</BaseLayout>
