# Copy this file to .env (or .env.production) and edit. Never commit the real file.

# Production URL used for canonical links, Open Graph tags, robots.txt and the sitemap.
SITE_URL=https://demandletter.hoffman.legal

# Sub-path the site is served from. Keep "/" for a domain or subdomain root.
BASE_PATH=/

# ---------------------------------------------------------------------------
# Intake form submission (see src/lib/intake/submit.ts)
#
# none     (default) No backend configured. The form tells the visitor that
#          nothing was sent and offers phone/email instead.
# endpoint POST JSON to PUBLIC_INTAKE_ENDPOINT (must be https://). Use a form
#          service (e.g. Formspree, Basin) or the firm's own handler. Only a 2xx
#          response is reported to the visitor as received.
# demo     Simulated success for local testing; labelled "Demo mode" in the UI.
#          Only active in `npm run dev` unless PUBLIC_INTAKE_ALLOW_DEMO=true.
# ---------------------------------------------------------------------------
# PUBLIC_INTAKE_PROVIDER=endpoint
# PUBLIC_INTAKE_ENDPOINT=https://formspree.io/f/your-form-id
# PUBLIC_INTAKE_ALLOW_DEMO=false
